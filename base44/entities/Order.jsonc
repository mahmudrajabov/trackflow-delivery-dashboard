{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "items": {
      "type": "string"
    },
    "courier_name": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_transit",
        "delivered",
        "cancelled"
      ],
      "default": "pending"
    },
    "order_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "order_number",
    "customer_name",
    "address",
    "status"
  ]
}